NFT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NFT_CHAIN_ID=11155111
# WalletConnect / Reown project id for real wallet connection (next phase)
VITE_WALLETCONNECT_PROJECT_ID=
